{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["results"],
  "properties": {
    "results": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "decision", "reason"],
        "properties": {
          "id": {"type": "string"},
          "decision": {"enum": ["allowed", "blocked", "draft"]},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
