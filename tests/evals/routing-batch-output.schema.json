{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["results"],
  "properties": {
    "results": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "scope", "mode", "selected_skill", "reason"],
        "properties": {
          "id": {"type": "string"},
          "scope": {"enum": ["in-scope", "out-of-scope"]},
          "mode": {
            "type": ["string", "null"],
            "enum": ["compare", "refine", "present", null]
          },
          "selected_skill": {"type": ["string", "null"]},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
